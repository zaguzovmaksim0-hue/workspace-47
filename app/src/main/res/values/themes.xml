<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JuntaFirmaMobile" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/jfm_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/jfm_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Draws opaquely, but the window is translucent so the browser below is
         only paused: opening the download screen must not count as leaving the
         app, which would end a certificate session or lock the certificate. -->
    <style name="Theme.JuntaFirmaMobile.Overlay">
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
