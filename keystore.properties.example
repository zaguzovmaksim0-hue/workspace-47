# Template only: Gradle does not read keystore.properties.
# Private `release` builds read these four names as Gradle properties or
# environment variables (docs/release-signing.md). Keep real values outside Git,
# for example in ~/.gradle/gradle.properties with mode 600.
# Daily-use APKs are signed in GitHub Actions instead (docs/daily-apk-signing.md).

# Absolute path to the private PKCS12 keystore.
JFM_RELEASE_STORE_FILE=/absolute/path/to/release-keystore.p12
# Keystore password.
JFM_RELEASE_STORE_PASSWORD=
# Alias of the signing entry inside the keystore.
JFM_RELEASE_KEY_ALIAS=
# Entry password (for PKCS12 usually the same as the keystore password).
JFM_RELEASE_KEY_PASSWORD=
